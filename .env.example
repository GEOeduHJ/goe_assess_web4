# Google Gemini API Configuration
# 여기에 Google AI Studio에서 발급받은 Gemini API 키를 입력하세요.
GOOGLE_API_KEY=

# OpenAI API Configuration
# 여기에 OpenAI Platform에서 발급받은 API 키를 입력하세요.
OPENAI_API_KEY=

# Application Settings
APP_TITLE=지리과 자동 채점 플랫폼
MAX_FILE_SIZE_MB=100
GEMINI_MODEL=gemini-3.1-flash-lite
GPT_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=nlpai-lab/KURE-v1
FAISS_INDEX_TYPE=IndexFlatIP

# Processing Settings
MAX_RETRIES=3
RETRY_DELAY=2
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=3
